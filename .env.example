PORT=7100
MONGODB_URI=mongodb://127.0.0.1:27017/tizimplus_hostel
FRONTEND_URL=http://localhost:5173
INITIAL_OWNER_FIRSTNAME=Admin
INITIAL_OWNER_LASTNAME=User
INITIAL_OWNER_LOGIN=admin
INITIAL_OWNER_PASSWORD=ChangeMe123!
TEXTUP_EMAIL=
TEXTUP_PASSWORD=
# Ixtiyoriy: bo‘sh qoldirilsa, tasdiqlangan template ID avtomatik topiladi
TEXTUP_TEMPLATE_ID=
# Ixtiyoriy: TextUp’dagi tasdiqlangan Alpha name ID
TEXTUP_NICKNAME_ID=
TEXTUP_TIMEOUT_MS=8000
# Ixtiyoriy: eski alohida Universal FaceID HMAC endpointi uchun
FACEID_INTEGRATION_SECRET=
# Bir talabaning tasodifiy takroriy skanlari SMS hisoblagichini oshirmasligi uchun
FACEID_RESCAN_SECONDS=300
# SMS tashqi API xatosida MongoDB navbatidan qayta yuboriladi
FACEID_SMS_MAX_ATTEMPTS=8
FACEID_SMS_WORKER_SECONDS=30

# Asosiy production transport: Hikvision Device Gateway/ISUP SDK HTTP adapteri
# Adapter shartnomasi FACEID_INTEGRATION.md ichida. {deviceId} va {isapiPath} placeholderlari qo‘llanadi.
HIKVISION_GATEWAY_DEVICE_URL_TEMPLATE=
HIKVISION_GATEWAY_REQUEST_MODE=bridge
HIKVISION_GATEWAY_TOKEN=
HIKVISION_GATEWAY_WEBHOOK_SECRET=
HIKVISION_GATEWAY_ALLOWED_IPS=127.0.0.1,::1
HIKVISION_GATEWAY_DECISION_MODE=push
HIKVISION_GATEWAY_TIMEOUT_MS=4000
HIKVISION_ONLINE_WINDOW_SECONDS=180

# Faqat LAN/VPN diagnostika yoki fallback uchun direct ISAPI sozlamalari
HIKVISION_HOST=
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=
HIKVISION_AUTH_MODE=digest
HIKVISION_DOOR_NO=1
# Qurilma va gateway sinovi tugamaguncha false qoldiring
HIKVISION_DOOR_CONTROL_ENABLED=false
HIKVISION_TIMEOUT_MS=5000
# Direct callback uchun ruxsat etilgan IP manzillar
HIKVISION_EVENT_ALLOWED_IPS=
HIKVISION_OPEN_DOOR_PATH=/ISAPI/AccessControl/RemoteControl/door/{doorNo}
HIKVISION_REMOTE_CHECK_PATH=/ISAPI/AccessControl/remoteCheck?format=json
